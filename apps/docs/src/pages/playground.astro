---
import Base from "../layouts/Base.astro";
import {
  renderButton,
  renderInput,
  renderCard,
  renderAlert,
  renderLink,
  renderStack,
  renderField,
  renderSelect,
  renderCheckbox,
  renderBanner,
} from "../../../../packages/ds/src/components/index.js";

const samples = {
  buttonPrimary: renderButton({ variant: "primary", label: "Primary" }),
  buttonSecondary: renderButton({ variant: "secondary", label: "Secondary" }),
  buttonDanger: renderButton({ variant: "danger", label: "Danger" }),
  input: renderInput({ label: "Name", id: "playground-name" }),
  card: renderCard({ elevated: true, body: "Card with elevation token" }),
  alert: renderAlert({ tone: "warning", message: "Check contrast and focus rings" }),
  link: renderLink({ href: "#playground", label: "Design system link" }),
  stack: renderStack({
    gap: "md",
    body: `${renderButton({ variant: "secondary", label: "One" })}${renderButton({ variant: "primary", label: "Two" })}`,
  }),
  field: renderField({
    id: "playground-email",
    label: "Email",
    invalid: true,
    error: "Enter a valid email",
  }),
  select: renderSelect({
    id: "playground-select",
    label: "Region",
    value: "eu",
    options: [
      { value: "", label: "Choose…" },
      { value: "eu", label: "Europe" },
      { value: "us", label: "Americas" },
    ],
  }),
  checkbox: renderCheckbox({
    id: "playground-terms",
    label: "I agree to the terms",
    checked: true,
  }),
  banner: renderBanner({
    tone: "info",
    role: "status",
    body: "Persistent banner — no auto-dismiss",
  }),
};
---
<Base title="Playground">
  <h1>Playground</h1>
  <p>Primitives montados con tokens <code>--ds-*</code>. Usa los controles Light / Dark / System del header.</p>

  <section class="ds-card" style="margin-block: var(--ds-space-lg); display:grid; gap: var(--ds-space-md);">
    <h2>Buttons</h2>
    <div style="display:flex; gap: var(--ds-space-sm); flex-wrap:wrap;">
      <Fragment set:html={samples.buttonPrimary} />
      <Fragment set:html={samples.buttonSecondary} />
      <Fragment set:html={samples.buttonDanger} />
    </div>

    <h2>Input</h2>
    <Fragment set:html={samples.input} />

    <h2>Card</h2>
    <Fragment set:html={samples.card} />

    <h2>Alert</h2>
    <Fragment set:html={samples.alert} />

    <h2>Link</h2>
    <Fragment set:html={samples.link} />

    <h2>Stack</h2>
    <Fragment set:html={samples.stack} />

    <h2>Field</h2>
    <Fragment set:html={samples.field} />

    <h2>Select</h2>
    <Fragment set:html={samples.select} />

    <h2>Checkbox</h2>
    <Fragment set:html={samples.checkbox} />

    <h2>Banner</h2>
    <Fragment set:html={samples.banner} />
  </section>

  <aside class="ds-alert ds-alert--info" role="status">
    <strong>Info:</strong> tokens activos vía CSS variables; el cambio de tema no modifica el markup de los componentes.
  </aside>
</Base>
