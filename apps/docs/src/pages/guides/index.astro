---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const guides = (await getCollection("guides")).sort((a, b) =>
  a.id.localeCompare(b.id)
);
---
<Base
  title="Guides"
  description="Guías de instalación, tematización, migración y contribución."
>
  <h1>Guides</h1>
  <p>
    Guías alineadas con fixtures de consumo (tarball). Fuente:
    <code>docs/guides/</code>.
  </p>
  <ul>
    {
      guides.map((g) => (
        <li>
          <a href={`/guides/${g.id}/`}>{g.id}</a>
          {" — "}
          <code>{`docs/guides/${g.id}.md`}</code>
        </li>
      ))
    }
    <li>
      Tematización y marcas (<code>setTheme</code>, <code>data-brand</code>) —
      pendiente
    </li>
    <li>Migración — pendiente (F6-05)</li>
    <li>Contribuir — ver <code>CONTRIBUTING.md</code></li>
  </ul>
</Base>
