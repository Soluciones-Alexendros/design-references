---
/**
 * Placeholder theme chrome until F3 ThemeToggle merges (F5-06).
 * Uses setTheme from @soluciones-alexendros/ds; group with aria-pressed.
 * Persistence key: localStorage `ds-theme`.
 */
---
<div
  class="theme-controls"
  data-theme-controls
  role="group"
  aria-label="Tema"
>
  <button
    type="button"
    class="ds-button ds-button--secondary"
    data-theme-set="light"
    aria-pressed="false">Light</button
  >
  <button
    type="button"
    class="ds-button ds-button--secondary"
    data-theme-set="dark"
    aria-pressed="false">Dark</button
  >
  <button
    type="button"
    class="ds-button ds-button--secondary"
    data-theme-set="system"
    aria-pressed="false">System</button
  >
</div>

<script>
  import { setTheme } from "@soluciones-alexendros/ds";

  const KEY = "ds-theme";

  function currentMode() {
    const stored = localStorage.getItem(KEY);
    return stored === "light" || stored === "dark" || stored === "system"
      ? stored
      : "system";
  }

  function syncPressed(mode) {
    document
      .querySelectorAll("[data-theme-controls] [data-theme-set]")
      .forEach((btn) => {
        const active = btn.getAttribute("data-theme-set") === mode;
        btn.setAttribute("aria-pressed", active ? "true" : "false");
      });
  }

  function apply(mode) {
    const next = setTheme(mode);
    localStorage.setItem(KEY, next);
    syncPressed(next);
  }

  syncPressed(currentMode());
  document.querySelectorAll("[data-theme-set]").forEach((btn) => {
    btn.addEventListener("click", () => {
      apply(btn.getAttribute("data-theme-set") ?? "system");
    });
  });
</script>
