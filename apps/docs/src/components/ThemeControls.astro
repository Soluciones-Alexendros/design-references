---
/**
 * Docs chrome ThemeToggle — thin wrapper over @soluciones-alexendros/ds ThemeToggle.
 * Persistence: localStorage `ds-theme` via setTheme + theme-boot in Base.
 */
import "../../../../packages/ds/src/components/ThemeToggle.css";
import { renderThemeToggle } from "../../../../packages/ds/src/components/ThemeToggle.js";

const html = renderThemeToggle({ value: "system", label: "Tema" });
---
<Fragment set:html={html} />

<script>
  import { attachThemeToggle } from "../../../../packages/ds/src/components/ThemeToggle.js";
  attachThemeToggle(document);
</script>
