---
import "../styles/site.css";
import "../styles/components.css";
import { renderThemeToggle } from "../../../../packages/ds/src/components/ThemeToggle.js";
import themeBoot from "../../../../packages/ds/src/theme-boot.js?raw";
import stylesCss from "../../../../packages/ds/dist/styles.css?raw";
import {
  absoluteUrl,
  SITE_ORIGIN,
  themeColorsFromCss,
} from "../lib/site";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Design system @soluciones-alexendros/ds" } =
  Astro.props;

const foundations = [
  { href: "/foundations/color/", label: "Color" },
  { href: "/foundations/typography/", label: "Typography" },
  { href: "/foundations/spacing/", label: "Spacing" },
  { href: "/foundations/radius/", label: "Radius" },
  { href: "/foundations/elevation/", label: "Elevation" },
  { href: "/foundations/motion/", label: "Motion" },
];

const primaryNav = [
  { href: "/", label: "Inicio" },
  { href: "/foundations/color/", label: "Foundations" },
  { href: "/components/", label: "Components" },
  { href: "/guides/", label: "Guides" },
  { href: "/a11y/", label: "A11y" },
  { href: "/playground/", label: "Playground" },
  { href: "/patterns/", label: "Patterns" },
  { href: "/changelog/", label: "Changelog" },
  { href: "/fleet/", label: "Fleet" },
];

const themeToggleHtml = renderThemeToggle({
  value: "system",
  label: "Tema",
});

const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = absoluteUrl(pathname, Astro.site?.href ?? SITE_ORIGIN);
const pageTitle = `${title} · design-references`;
const themeColors = themeColorsFromCss(stylesCss);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={themeColors.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={themeColors.dark}
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="design-references" />
    <script is:inline set:html={themeBoot} />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <div class="shell">
      <nav class="nav" aria-label="Principal">
        <a class="nav-brand" href="/">design-references</a>
        {
          primaryNav.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
        <div class="theme-controls" data-theme-controls>
          <Fragment set:html={themeToggleHtml} />
        </div>
      </nav>
      <nav class="foundations-nav" aria-label="Foundations">
        {
          foundations.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
      <main id="main">
        <slot />
      </main>
    </div>
    <script>
      import { attachThemeToggle } from "../../../../packages/ds/src/components/ThemeToggle.js";
      attachThemeToggle(document);
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: var(--ds-space-sm);
    top: var(--ds-space-sm);
    padding: var(--ds-space-sm) var(--ds-space-md);
    background: var(--ds-color-bg-primary);
    color: var(--ds-color-text-on-primary);
    border-radius: var(--ds-radius-control);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .theme-controls {
    margin-left: auto;
  }
</style>
