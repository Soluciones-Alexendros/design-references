---
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";
import "@soluciones-alexendros/ds/styles.css";
import "../../../../packages/ds/src/css/layers.css";
import "../../../../packages/ds/src/components/Button.css";
import "../../../../packages/ds/src/components/Input.css";
import "../../../../packages/ds/src/components/Card.css";
import "../../../../packages/ds/src/components/Alert.css";
import "../../../../packages/ds/src/components/Link.css";
import "../../../../packages/ds/src/components/Stack.css";
import "../../../../packages/ds/src/components/Field.css";
import "../../../../packages/ds/src/components/ThemeToggle.css";
import { renderThemeToggle } from "../../../../packages/ds/src/components/ThemeToggle.js";

interface Props {
  title: string;
}
const { title } = Astro.props;
const themeBoot = readFileSync(
  join(
    dirname(fileURLToPath(import.meta.url)),
    "../../../../packages/ds/src/theme-boot.js"
  ),
  "utf8"
);
const themeToggleHtml = renderThemeToggle({
  value: "system",
  label: "Theme",
});
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · design-references</title>
    <script is:inline set:html={themeBoot} />
    <style is:global>
      body {
        margin: 0;
        min-height: 100vh;
        background: var(--ds-color-bg-surface);
        color: var(--ds-color-text-default);
        font-family: var(--ds-type-family-sans);
        font-size: var(--ds-type-size-body);
        line-height: var(--ds-type-lineHeight-body);
      }
      a { color: var(--ds-color-text-link); }
      .shell {
        max-width: 960px;
        margin: 0 auto;
        padding: var(--ds-space-lg);
      }
      .nav {
        display: flex;
        gap: var(--ds-space-md);
        align-items: center;
        margin-bottom: var(--ds-space-xl);
        flex-wrap: wrap;
      }
      .nav a { text-decoration: none; }
      .theme-controls {
        margin-left: auto;
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <nav class="nav" aria-label="Principal">
        <strong>design-references</strong>
        <a href="/">Inicio</a>
        <a href="/tokens">Tokens</a>
        <a href="/playground">Playground</a>
        <div class="theme-controls" data-theme-controls>
          <Fragment set:html={themeToggleHtml} />
        </div>
      </nav>
      <slot />
    </div>
    <script>
      import { attachThemeToggle } from "../../../../packages/ds/src/components/ThemeToggle.js";
      attachThemeToggle(document);
    </script>
  </body>
</html>
