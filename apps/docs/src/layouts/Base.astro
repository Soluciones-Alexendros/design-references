---
import "../styles/site.css";
import "../styles/components.css";
import "../../../../packages/ds/src/components/ThemeToggle.css";
import { renderThemeToggle } from "../../../../packages/ds/src/components/ThemeToggle.js";
import themeBoot from "../../../../packages/ds/src/theme-boot.js?raw";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Design system @soluciones-alexendros/ds" } =
  Astro.props;

const foundations = [
  { href: "/foundations/color/", label: "Color" },
  { href: "/foundations/typography/", label: "Typography" },
  { href: "/foundations/spacing/", label: "Spacing" },
  { href: "/foundations/radius/", label: "Radius" },
  { href: "/foundations/elevation/", label: "Elevation" },
  { href: "/foundations/motion/", label: "Motion" },
];

const themeToggleHtml = renderThemeToggle({
  value: "system",
  label: "Tema",
});
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · design-references</title>
    <script is:inline set:html={themeBoot} />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <div class="shell">
      <nav class="nav" aria-label="Principal">
        <a class="nav-brand" href="/">design-references</a>
        <a href="/">Inicio</a>
        <a href="/foundations/color/">Foundations</a>
        <a href="/playground/">Playground</a>
        <div class="theme-controls" data-theme-controls>
          <Fragment set:html={themeToggleHtml} />
        </div>
      </nav>
      <nav class="foundations-nav" aria-label="Foundations">
        {
          foundations.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
      <main id="main">
        <slot />
      </main>
    </div>
    <script>
      import { attachThemeToggle } from "../../../../packages/ds/src/components/ThemeToggle.js";
      attachThemeToggle(document);
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: var(--ds-space-sm);
    top: var(--ds-space-sm);
    padding: var(--ds-space-sm) var(--ds-space-md);
    background: var(--ds-color-bg-primary);
    color: var(--ds-color-text-on-primary);
    border-radius: var(--ds-radius-control);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .theme-controls {
    margin-left: auto;
  }
</style>
