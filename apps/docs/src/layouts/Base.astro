---
import "../styles/site.css";
import "../styles/components.css";
import ThemeControls from "../components/ThemeControls.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Design system @soluciones-alexendros/ds" } =
  Astro.props;

const foundations = [
  { href: "/foundations/color/", label: "Color" },
  { href: "/foundations/typography/", label: "Typography" },
  { href: "/foundations/spacing/", label: "Spacing" },
  { href: "/foundations/radius/", label: "Radius" },
  { href: "/foundations/elevation/", label: "Elevation" },
  { href: "/foundations/motion/", label: "Motion" },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · design-references</title>
    <!-- Theme boot: prefer ds-theme before paint (placeholder until F3 ThemeToggle / F5-06). -->
    <script is:inline>
      (function () {
        try {
          var mode = localStorage.getItem("ds-theme");
          if (mode === "light" || mode === "dark") {
            document.documentElement.setAttribute("data-theme", mode);
          } else {
            document.documentElement.removeAttribute("data-theme");
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <div class="shell">
      <nav class="nav" aria-label="Principal">
        <a class="nav-brand" href="/">design-references</a>
        <a href="/">Inicio</a>
        <a href="/foundations/color/">Foundations</a>
        <a href="/playground/">Playground</a>
        <ThemeControls />
      </nav>
      <nav class="foundations-nav" aria-label="Foundations">
        {
          foundations.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
      <main id="main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: var(--ds-space-sm);
    top: var(--ds-space-sm);
    padding: var(--ds-space-sm) var(--ds-space-md);
    background: var(--ds-color-bg-primary);
    color: var(--ds-color-text-on-primary);
    border-radius: var(--ds-radius-control);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
