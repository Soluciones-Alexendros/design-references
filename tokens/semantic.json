{
  "$description": "DTCG 2025.10 semantic layer — light/dark role tokens (categoría.rol[.estado])",
  "color": {
    "$type": "color",
    "light": {
      "bg": {
        "surface": { "$value": "{color.neutral.50}" },
        "surface-elevated": { "$value": "{color.neutral.0}" },
        "primary": { "$value": "{color.blue.500}" },
        "primary-hover": { "$value": "{color.blue.700}" },
        "primary-active": { "$value": "{color.blue.900}" },
        "secondary": { "$value": "{color.neutral.200}" },
        "error": { "$value": "{color.red.500}" },
        "error-hover": { "$value": "{color.red.700}" },
        "error-active": { "$value": "{color.red.900}" },
        "success": { "$value": "{color.green.500}" },
        "warning": { "$value": "{color.amber.500}" },
        "disabled": { "$value": "{color.neutral.200}" }
      },
      "text": {
        "default": { "$value": "{color.neutral.900}" },
        "muted": { "$value": "{color.neutral.600}" },
        "on-primary": { "$value": "{color.neutral.0}" },
        "on-secondary": { "$value": "{color.neutral.900}" },
        "on-error": { "$value": "{color.neutral.0}" },
        "on-success": { "$value": "{color.neutral.0}" },
        "on-warning": { "$value": "{color.amber.800}" },
        "on-disabled": { "$value": "{color.neutral.500}" },
        "link": { "$value": "{color.blue.500}" },
        "link-hover": { "$value": "{color.blue.700}" }
      },
      "border": {
        "default": { "$value": "{color.neutral.500}" },
        "strong": { "$value": "{color.neutral.600}" },
        "focus": { "$value": "{color.neutral.950}" },
        "error": { "$value": "{color.red.500}" }
      },
      "icon": {
        "default": { "$value": "{color.neutral.800}" },
        "on-primary": { "$value": "{color.neutral.0}" },
        "on-error": { "$value": "{color.neutral.0}" }
      }
    },
    "dark": {
      "bg": {
        "surface": { "$value": "{color.neutral.900}" },
        "surface-elevated": { "$value": "{color.neutral.800}" },
        "primary": { "$value": "{color.blue.400}" },
        "primary-hover": { "$value": "{color.blue.300}" },
        "primary-active": { "$value": "oklch(0.58 0.15 250)" },
        "secondary": { "$value": "{color.neutral.700}" },
        "error": { "$value": "{color.red.400}" },
        "error-hover": { "$value": "oklch(0.58 0.17 25)" },
        "error-active": { "$value": "{color.red.500}" },
        "success": { "$value": "{color.green.500}" },
        "warning": { "$value": "{color.amber.500}" },
        "disabled": { "$value": "{color.neutral.700}" }
      },
      "text": {
        "default": { "$value": "{color.neutral.50}" },
        "muted": { "$value": "{color.neutral.300}" },
        "on-primary": { "$value": "{color.neutral.950}" },
        "on-secondary": { "$value": "{color.neutral.50}" },
        "on-error": { "$value": "{color.neutral.0}" },
        "on-success": { "$value": "{color.neutral.0}" },
        "on-warning": { "$value": "{color.amber.800}" },
        "on-disabled": { "$value": "{color.neutral.400}" },
        "link": { "$value": "oklch(0.6 0.14 250)" },
        "link-hover": { "$value": "{color.blue.300}" }
      },
      "border": {
        "default": { "$value": "{color.neutral.400}" },
        "strong": { "$value": "{color.neutral.300}" },
        "focus": { "$value": "{color.neutral.0}" },
        "error": { "$value": "{color.red.100}" }
      },
      "icon": {
        "default": { "$value": "{color.neutral.100}" },
        "on-primary": { "$value": "{color.neutral.950}" },
        "on-error": { "$value": "{color.neutral.0}" }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": "{spacing.1}" },
    "sm": { "$value": "{spacing.2}" },
    "md": { "$value": "{spacing.4}" },
    "lg": { "$value": "{spacing.5}" },
    "xl": { "$value": "{spacing.6}" },
    "touch": { "$value": "{spacing.5}" }
  },
  "type": {
    "family": {
      "sans": { "$value": "{fontFamily.sans}" },
      "mono": { "$value": "{fontFamily.mono}" }
    },
    "size": {
      "body": { "$value": "{fontSize.md}" },
      "label": { "$value": "{fontSize.sm}" },
      "title": { "$value": "{fontSize.xl}" },
      "display": { "$value": "{fontSize.3xl}" }
    },
    "weight": {
      "regular": { "$value": "{fontWeight.regular}" },
      "medium": { "$value": "{fontWeight.medium}" },
      "bold": { "$value": "{fontWeight.bold}" }
    },
    "lineHeight": {
      "body": { "$value": "{lineHeight.normal}" },
      "tight": { "$value": "{lineHeight.tight}" }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "{radius.md}" },
    "surface": { "$value": "{radius.lg}" }
  },
  "elevation": {
    "$type": "shadow",
    "surface": { "$value": "{elevation.1}" },
    "overlay": { "$value": "{elevation.2}" }
  }
}
