{
  "$description": "DTCG 2025.10 semantic layer — light/dark role tokens",
  "color": {
    "$type": "color",
    "light": {
      "bg": {
        "surface": { "$value": "{color.neutral.50}" },
        "surface-elevated": { "$value": "{color.neutral.0}" },
        "primary": { "$value": "{color.blue.500}" },
        "secondary": { "$value": "{color.neutral.200}" },
        "error": { "$value": "{color.red.500}" },
        "success": { "$value": "{color.green.500}" },
        "warning": { "$value": "{color.amber.500}" },
        "disabled": { "$value": "{color.neutral.200}" }
      },
      "text": {
        "on-surface": { "$value": "{color.neutral.900}" },
        "on-surface-muted": { "$value": "{color.neutral.600}" },
        "on-primary": { "$value": "{color.neutral.0}" },
        "on-secondary": { "$value": "{color.neutral.900}" },
        "on-error": { "$value": "{color.neutral.0}" },
        "on-success": { "$value": "{color.neutral.0}" },
        "on-warning": { "$value": "{color.amber.800}" },
        "on-disabled": { "$value": "{color.neutral.500}" },
        "link": { "$value": "{color.blue.700}" }
      },
      "border": {
        "default": { "$value": "{color.neutral.300}" },
        "strong": { "$value": "{color.neutral.500}" },
        "focus": { "$value": "{color.blue.500}" },
        "error": { "$value": "{color.red.500}" }
      },
      "icon": {
        "on-surface": { "$value": "{color.neutral.800}" },
        "on-primary": { "$value": "{color.neutral.0}" },
        "on-error": { "$value": "{color.neutral.0}" }
      }
    },
    "dark": {
      "bg": {
        "surface": { "$value": "{color.neutral.900}" },
        "surface-elevated": { "$value": "{color.neutral.800}" },
        "primary": { "$value": "{color.blue.300}" },
        "secondary": { "$value": "{color.neutral.700}" },
        "error": { "$value": "{color.red.500}" },
        "success": { "$value": "{color.green.500}" },
        "warning": { "$value": "{color.amber.500}" },
        "disabled": { "$value": "{color.neutral.700}" }
      },
      "text": {
        "on-surface": { "$value": "{color.neutral.50}" },
        "on-surface-muted": { "$value": "{color.neutral.300}" },
        "on-primary": { "$value": "{color.neutral.950}" },
        "on-secondary": { "$value": "{color.neutral.50}" },
        "on-error": { "$value": "{color.neutral.0}" },
        "on-success": { "$value": "{color.neutral.0}" },
        "on-warning": { "$value": "{color.amber.800}" },
        "on-disabled": { "$value": "{color.neutral.400}" },
        "link": { "$value": "{color.blue.100}" }
      },
      "border": {
        "default": { "$value": "{color.neutral.600}" },
        "strong": { "$value": "{color.neutral.400}" },
        "focus": { "$value": "{color.blue.300}" },
        "error": { "$value": "{color.red.100}" }
      },
      "icon": {
        "on-surface": { "$value": "{color.neutral.100}" },
        "on-primary": { "$value": "{color.neutral.950}" },
        "on-error": { "$value": "{color.neutral.0}" }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": "{spacing.1}" },
    "sm": { "$value": "{spacing.2}" },
    "md": { "$value": "{spacing.4}" },
    "lg": { "$value": "{spacing.5}" },
    "xl": { "$value": "{spacing.6}" },
    "touch": { "$value": "{spacing.5}" }
  },
  "type": {
    "family": {
      "sans": { "$value": "{fontFamily.sans}" },
      "mono": { "$value": "{fontFamily.mono}" }
    },
    "size": {
      "body": { "$value": "{fontSize.md}" },
      "label": { "$value": "{fontSize.sm}" },
      "title": { "$value": "{fontSize.xl}" },
      "display": { "$value": "{fontSize.3xl}" }
    },
    "weight": {
      "regular": { "$value": "{fontWeight.regular}" },
      "medium": { "$value": "{fontWeight.medium}" },
      "bold": { "$value": "{fontWeight.bold}" }
    },
    "lineHeight": {
      "body": { "$value": "{lineHeight.normal}" },
      "tight": { "$value": "{lineHeight.tight}" }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "{radius.md}" },
    "surface": { "$value": "{radius.lg}" }
  },
  "elevation": {
    "$type": "shadow",
    "surface": { "$value": "{elevation.1}" },
    "overlay": { "$value": "{elevation.2}" }
  },
  "$extensions": {
    "org.soluciones-alexendros.contrastPairs": [
      {
        "name": "text.on-surface / bg.surface",
        "foreground": "text.on-surface",
        "background": "bg.surface",
        "level": "normal"
      },
      {
        "name": "text.on-surface-muted / bg.surface",
        "foreground": "text.on-surface-muted",
        "background": "bg.surface",
        "level": "normal"
      },
      {
        "name": "text.on-primary / bg.primary",
        "foreground": "text.on-primary",
        "background": "bg.primary",
        "level": "normal"
      },
      {
        "name": "text.on-secondary / bg.secondary",
        "foreground": "text.on-secondary",
        "background": "bg.secondary",
        "level": "normal"
      },
      {
        "name": "text.on-error / bg.error",
        "foreground": "text.on-error",
        "background": "bg.error",
        "level": "normal"
      },
      {
        "name": "text.on-success / bg.success",
        "foreground": "text.on-success",
        "background": "bg.success",
        "level": "normal"
      },
      {
        "name": "text.on-warning / bg.warning",
        "foreground": "text.on-warning",
        "background": "bg.warning",
        "level": "normal"
      },
      {
        "name": "text.on-disabled / bg.disabled",
        "foreground": "text.on-disabled",
        "background": "bg.disabled",
        "level": "ui"
      },
      {
        "name": "text.link / bg.surface",
        "foreground": "text.link",
        "background": "bg.surface",
        "level": "normal"
      },
      {
        "name": "icon.on-surface / bg.surface",
        "foreground": "icon.on-surface",
        "background": "bg.surface",
        "level": "ui"
      },
      {
        "name": "icon.on-primary / bg.primary",
        "foreground": "icon.on-primary",
        "background": "bg.primary",
        "level": "ui"
      },
      {
        "name": "icon.on-error / bg.error",
        "foreground": "icon.on-error",
        "background": "bg.error",
        "level": "ui"
      },
      {
        "name": "border.focus / bg.surface",
        "foreground": "border.focus",
        "background": "bg.surface",
        "level": "ui"
      }
    ]
  }
}
