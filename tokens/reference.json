  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "100ms" },
      "normal": { "$value": "200ms" },
      "slow": { "$value": "300ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$value": [0.3, 0, 0, 1] }
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "hairline": { "$value": "1px" },
      "focus": { "$value": "2px" }
    },
    "offset": {
      "$type": "dimension",
      "focus": { "$value": "2px" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "8": { "$value": "48px" },
    "10": { "$value": "64px" }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "sans": {
      "$value": ["Inter", "system-ui", "Segoe UI", "Roboto", "sans-serif"]
    },
    "mono": {
      "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
    }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": { "$value": "12px" },
    "sm": { "$value": "14px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "18px" },
    "xl": { "$value": "20px" },
    "2xl": { "$value": "24px" },
    "3xl": { "$value": "30px" }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "lineHeight": {
    "$type": "number",
    "tight": { "$value": 1.25 },
    "normal": { "$value": 1.5 },
    "relaxed": { "$value": 1.75 }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },
  "elevation": {
    "$type": "shadow",
    "0": {
      "$value": []
    },
    "1": {
      "$value": [
        {
          "color": "oklch(0.2 0.02 250 / 0.12)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ]
    },
    "2": {
      "$value": [
        {
          "color": "oklch(0.2 0.02 250 / 0.14)",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0px"
        }
      ]
    },
    "3": {
      "$value": [
        {
          "color": "oklch(0.2 0.02 250 / 0.18)",
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "24px",
          "spread": "0px"
        }
      ]
    }
  }
