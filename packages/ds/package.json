{
  "name": "@soluciones-alexendros/ds",
  "version": "0.1.0",
  "description": "Design system tokens (--ds-*), theme-boot and base primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/styles.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.d.ts"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./theme-boot": "./dist/theme-boot.js",
    "./css": "./dist/css/components.css",
    "./astro": "./src/astro/index.js",
    "./astro/*": "./src/astro/*",
    "./react": "./src/react/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/astro",
    "src/react",
    "src/components",
    "src/css",
    "src/theme.js",
    "src/theme-boot.js"
  ],
  "scripts": {
    "build": "node ./scripts/build-tokens.mjs",
    "test:resolve": "node ./scripts/resolve-semantic.mjs",
    "test:theme": "node ./scripts/test-theme.mjs",
    "test:contrast": "node ./scripts/contrast-runner.mjs",
    "test:a11y": "node ./scripts/a11y-playwright.mjs",
    "test:a11y:smoke": "node ./scripts/a11y-runner.mjs",
    "test:primitives": "node ./scripts/test-primitives.mjs",
    "test:wrappers": "node ./scripts/test-wrappers.mjs",
    "test:pack": "node ../../scripts/check-pack-allowlist.mjs",
    "lint:tokens-only": "node ./scripts/lint-tokens-only.mjs",
    "prepack": "npm run build",
    "test": "npm run build && npm run test:resolve && npm run test:theme && npm run test:contrast && npm run lint:tokens-only && npm run test:primitives && npm run test:wrappers && npm run test:a11y:smoke && npm run test:a11y && npm run test:pack"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.3",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
